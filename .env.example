# Copy this file to `.env.local` and fill in your own values. Never commit `.env.local`.
#
# Google Maps browser API key (needs "Maps JavaScript API" and "Places API (New)").
# This key is embedded in the built website and visible to anyone, so restrict it
# by HTTP referrer and by API in Google Cloud Console. See README.md.
VITE_GOOGLE_MAPS_API_KEY=

# Supabase: Project Settings -> API Keys / API.
# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# The PUBLISHABLE key (starts with sb_publishable_). It is designed to be public.
# NEVER put the secret key (sb_secret_...) or a service_role key in any VITE_ variable
# or in frontend code: it would be exposed to every visitor.
VITE_SUPABASE_PUBLISHABLE_KEY=
